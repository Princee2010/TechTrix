# Copy this file to .env and add your key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=all-MiniLM-L6-v2
# Minimum cosine similarity for a passage to count as evidence (tune using Analytics page)
MIN_SCORE=0.30

# Scanned PDFs (needs the Tesseract program installed; see README)
OCR_ENABLED=true
OCR_LANG=eng

# About page
DEVELOPER_NAME=Your Name
DEVELOPER_DETAILS=College, course, contact
